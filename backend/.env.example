DJANGO_SECRET_KEY=your-local-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=jornal_ai_dev
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Mood module only. Journal, memories and goals keep their own models.
OLLAMA_MOOD_MODEL=qwen2.5:7b

# Mood OCR. Tesseract is a separate Windows program; pytesseract only calls it.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Languages must already be installed in Tesseract. Add ara when ara.traineddata is present.
MOOD_OCR_LANGS=fra+eng
MOOD_OCR_MAX_BYTES=5242880
MOOD_OCR_MAX_PAGES=10
MOOD_OCR_MAX_CHARS=20000
# Scanned PDFs are rendered with Poppler (pdftoppm), then read by Tesseract. Set to 0 to disable.
MOOD_OCR_SCANNED_PDF=1
# POPPLER_PATH=C:\Program Files\poppler\Library\bin

# Local semantic search for mood notes. The model must already be installed in Ollama.
OLLAMA_MOOD_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_MOOD_EMBEDDING_DIMENSIONS=768
# Cosine similarity from -1 to 1. This is not a probability.
MOOD_EMBEDDING_MIN_SIMILARITY=0.45
# Missing embeddings generated during one search, and how many recent notes are compared.
MOOD_EMBEDDING_BACKFILL_LIMIT=20
MOOD_EMBEDDING_MAX_CANDIDATES=500