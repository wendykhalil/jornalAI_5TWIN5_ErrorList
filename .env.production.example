# ==============================================================================
# Jornal AI / MindLog AI - Production Environment Configuration
# Target: Azure VM (Ubuntu 24.04, 4 vCPU, 16 GB RAM, 64 GB SSD)
# Copy this file to .env on the production server and fill in strong values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core & Security
# ------------------------------------------------------------------------------
# Generate a strong 50+ character random key:
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-this-to-a-very-strong-secret-key-in-production

# Must be False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames or Azure VM public IP
# Example: mindlog-ai.swedencentral.cloudapp.azure.com,20.240.53.98,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,mindlog-ai.swedencentral.cloudapp.azure.com,20.240.53.98

# CORS allowed origins (if called from a separate origin; empty for same-origin via Nginx)
CORS_ALLOWED_ORIGINS=https://mindlog-ai.swedencentral.cloudapp.azure.com,http://mindlog-ai.swedencentral.cloudapp.azure.com

# CSRF trusted origins (required for POST requests via reverse proxy)
CSRF_TRUSTED_ORIGINS=https://mindlog-ai.swedencentral.cloudapp.azure.com,http://mindlog-ai.swedencentral.cloudapp.azure.com

# Set to True when HTTPS is enabled
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ------------------------------------------------------------------------------
# 2. Database (MariaDB 10.11 Docker Service)
# ------------------------------------------------------------------------------
DB_NAME=jornal_ai
DB_USER=jornal_user
DB_PASSWORD=choose-a-strong-database-password
MYSQL_ROOT_PASSWORD=choose-a-strong-root-password
DB_HOST=db
DB_PORT=3306

# ------------------------------------------------------------------------------
# 3. Gunicorn Process Configuration
# ------------------------------------------------------------------------------
# 2 workers with 2 threads per worker avoids memory exhaustion on 16GB RAM VM
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
# Extended timeout (seconds) for long-running CPU AI workloads
GUNICORN_TIMEOUT=300

# ------------------------------------------------------------------------------
# 4. Local Ollama LLM & Embeddings (Service 'ollama' in Docker)
# ------------------------------------------------------------------------------
OLLAMA_URL=http://ollama:11434/api/generate
OLLAMA_VISION_URL=http://ollama:11434/api/generate
OLLAMA_EMBED_URL=http://ollama:11434/api/embeddings

# Model for mood analysis and assistant (run 'scripts/init_ollama.sh' to pull)
OLLAMA_MOOD_MODEL=qwen2.5:7b

# General LLM model for journal, memories, goals
OLLAMA_MODEL=qwen2.5:7b

# Vision model for photo description in journal
OLLAMA_VISION_MODEL=llama3.2-vision

# Semantic search embeddings
OLLAMA_MOOD_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_MOOD_EMBEDDING_DIMENSIONS=768
MOOD_EMBEDDING_MIN_SIMILARITY=0.45
MOOD_EMBEDDING_BACKFILL_LIMIT=20
MOOD_EMBEDDING_MAX_CANDIDATES=500

# ------------------------------------------------------------------------------
# 5. Local Audio Transcription (Faster-Whisper on CPU)
# ------------------------------------------------------------------------------
# 'base' model (~140MB) provides high quality with fast CPU execution
# Set to 'small' (~460MB) if higher transcription accuracy is preferred
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MAX_CONCURRENT=1

# ------------------------------------------------------------------------------
# 6. Local OCR (Tesseract / Poppler in Docker)
# ------------------------------------------------------------------------------
MOOD_OCR_LANGS=fra+eng
MOOD_OCR_MAX_BYTES=5242880
MOOD_OCR_MAX_PAGES=10
MOOD_OCR_MAX_CHARS=20000
MOOD_OCR_SCANNED_PDF=1

# ------------------------------------------------------------------------------
# 7. AI Image Studio (Pollinations AI External API)
# ------------------------------------------------------------------------------
# Enter your Pollinations API key to enable live image generation and editing
POLLINATIONS_API_KEY=
POLLINATIONS_API_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
POLLINATIONS_EDIT_MODEL=black-forest-labs/flux.1-kontext-pro
POLLINATIONS_TIMEOUT=60
